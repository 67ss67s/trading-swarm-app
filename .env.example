# Trading Swarm - local configuration. Copy to .env, uncomment what you need and fill in a value.
# Everything is optional: with nothing set, `npm run dev` starts on paper execution with no model.
# scripts/dev.sh (npm run dev) loads .env. Never commit .env (it is in .gitignore).
# TG_ is the project's environment prefix (the internal name is trade-gate).

# --- Model keys -------------------------------------------------------------------------------
# OpenRouter key. On first start the gateway imports it into its key vault
# (<state dir>/secrets/model-keys.json, mode 600) and binds the "decision" role to the Jev judgment
# model (typesafe/jev via OpenRouter). The key is never sent to the browser.
# OPENROUTER_API_KEY=
#
# DeepSeek / Anthropic / Z.ai / OpenAI keys are added in the UI under "Model connections"
# (they are stored in the same vault, not read from this file). Local CLIs (pi, codex, claude)
# are detected automatically and can be bound to any role instead of an API key.

# --- Ports ------------------------------------------------------------------------------------
# TG_DEMO_PORT=          # gateway HTTP API (dev.sh default 18800)
# TG_UI_PORT=            # web UI, Vite dev server that proxies /api to TG_DEMO_PORT (dev.sh default 5180)

# --- Language ---------------------------------------------------------------------------------
# TG_PUBLIC_LANG=        # language of server-generated text: en (dev.sh default) or zh

# --- Exchange and execution -------------------------------------------------------------------
# TG_EXCHANGE=           # okx (dev.sh default) or binance
# TG_DEMO_BACKEND=       # paper (dev.sh default, in-process simulator, no keys), okx (OKX demo trading via the okx CLI) or auto
# OKX CLI (@okx_ai/okx-trade-cli). Credentials live in the CLI's own ~/.okx/config.toml, not here.
# TG_OKX_PROFILE=        # profile name in ~/.okx/config.toml (empty = its default_profile)
# TG_OKX_CLI=            # path to the okx binary (empty = ~/.local/bin/okx, then PATH)
# TG_OKX_LIVE=           # set to 1 only to allow a non-demo OKX profile

# --- Optional data sources ---------------------------------------------------------------------
# Directory of recorded BTC/ETH perp order-book and liquidation frames (gzip JSONL) used by the
# Jev judgment's live-only microstructure fields. The recorder that writes these frames is not
# part of this repository.
# TG_MICRO_DIR=

# --- Storage ----------------------------------------------------------------------------------
# TG_DEMO_HOME=          # state directory (dev.sh default ~/.trade-gate/demo)
# TG_DEMO_DB=            # state database (default $TG_DEMO_HOME/state.sqlite)
# TG_DEMO_SEED=          # set to 0 to skip loading the demo data on the first start

# --- Network ----------------------------------------------------------------------------------
# HTTPS_PROXY=           # only if you need a proxy to reach the exchange or model APIs
